{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keystone-moulding-tracker",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keystone-moulding-tracker",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "TRACKER_SETUP_EMAIL": "REPLACE_WITH_YOUR_ACCESS_EMAIL"
  },
  "routes": [
    {
      "pattern": "moulding.example.com",
      "custom_domain": true
    }
  ]
}

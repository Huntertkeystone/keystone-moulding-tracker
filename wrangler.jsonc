{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keystone-moulding-tracker",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keystone-moulding-tracker",
      "database_id": "9a6fa454-5db4-48ea-bc5c-a34d2a9f55e1"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "keystonewood.workers.dev",
    "ACCESS_AUD": "7edd2564a1c7e40885cf490fa9dbaa900c279b7203ce340295911df26f3a5f63",
    "TRACKER_SETUP_EMAIL": "hunter@keystonewood.com"
  },
  "routes": [
    {
      "pattern": "moulding.example.com",
      "custom_domain": true
    }
  ]
}
